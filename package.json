{
  "name": "obsidian-audio-to-text-whisper-plugin",
  "version": "0.4.0",
  "description": "Transcribes tagged audio in Obsidian notes with a local, offline Whisper and replaces it with text",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
